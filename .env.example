# System configuration
VITE_IS_DEMO=false # Set to 'true' to enable demo mode

# Support email shown across the site
PUB_SUPPORT_EMAIL=help@getsystem.org
PUB_IRB_EMAIL=irb@university.edu

# Argyle configuration
## This should be either https://api.argyle.com or https://api-sandbox.argyle.com
PUB_ARGYLE_LINK_URL=https://api.argyle.com
## The API key for accessing Argyle
VITE_ARGYLE_API_KEY=00000000-000-0000-0000-000000000000
## The API secret for accessing Argyle
VITE_ARGYLE_API_SECRET=ABCDEFGHIJK
## The webhook secret for verifying Argyle webhook signatures (from Argyle Console > Webhooks)
## This is a secret for testing on a feature branch only - sandbox, not for production!
## Only used by the legacy GLOBAL webhook route (/api/driver/argyle/webhooks). Per-org
## webhook routes (/api/driver/argyle/webhooks/[org_key]) verify against the org's own
## secret stored encrypted in organization_argyle_configs.webhook_secret.
ARGYLE_WEBHOOK_SECRET="your-argyle-webhook-secret"

## Used to encrypt per-organization Argyle API secrets before storing them in the
## database. Generate with: openssl rand -hex 32
ARGYLE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

## Base URL used when registering per-org Argyle webhook subscriptions. Falls back
## to the request origin if unset. In local dev, set it to your tunnel URL.
WEBHOOK_BASE_URL=https://sample.loca.lt

## Local development: To receive Argyle webhooks locally, run one of:
##   pnpm tunnel    -> https://sample.loca.lt
##   pnpm tunnel:2  -> https://sample2.loca.lt
##   pnpm tunnel:3  -> https://sample3.loca.lt
## These tunnels are configured with sandbox webhooks in the Argyle Console.
## Coordinate with teammates to use different subdomains.

# Supabase configuration
## The anon Supabase key, see: https://supabase.com/docs/guides/api/api-keys for more information
PUB_VITE_SUPABASE_ANON_KEY=areallylongstringofcharacters
## The service_role Supabase key, see: https://supabase.com/docs/guides/api/api-keys for more information
SUPABASE_SERVICE_KEY=areallylongstringofcharacters
## The URL of the Supabase deployment
PUB_VITE_SUPABASE_URL=http://adeployment.supabase.co
## A default password for accounts; this is used for testing only
SUPABASE_DEFAULT_PASSWORD=alongstringthatyouwanttousefortesting
## An indicator to Supabase that we use Twilio as the SMS provider.
## Note that we need this so that supabase sms works
GOTRUE_SMS_PROVIDER=twilio_verify

# Twilio configuration
## The Twilio account SID
PUB_VITE_TWILIO_SID=AC123456789
## The phone number to send SMS messages from
VITE_TWILIO_NUMBER=+15555555555
## The Twilio auth token
VITE_TWILIO_TOKEN=abcdefghijklmnopqrstuvwxyz

# SMTP configuration
## The SMTP server password
VITE_SMTP_PASS=password
VITE_SMTP_USER=username
## Sender for all outgoing email. Must be an address your SMTP provider lets
## this account send as. Defaults to "System" <organization@getsystem.org>.
SMTP_FROM="System" <organization@getsystem.org>

# Sentry configuration
# These are only needed in CI for the Production deploy context to upload
# source maps. Leave unset locally and on preview/branch deploys; the build
# will succeed and source-map upload will be skipped with a warning.
# Sentry itself is only `enabled` in production (see src/hooks.{client,server}.ts).
SENTRY_AUTH_TOKEN=sntrys_abcdefghijklmnop
SENTRY_ORG=a-sentry-organization-name
SENTRY_PROJECT=a-sentry-project-name

# Authentication for scheduled API endpointgs
INTERNAL_API_SECRET=a-secret-for-scheduled-api-endpoints

# Supabase Storage bucket for policy analysis exports
EXPORT_STORAGE_BUCKET=exports

# Optional one-time backfill: `pnpm seed:admins` with no args grants the admin
# role to existing auth users listed here. New admins: `pnpm seed:admins <email> <password>`.
# ADMIN_EMAILS=admin@getsystem.org

# Comma-separated inboxes for new organizer access alerts. Setting at least one
# recipient is what enables the alerts; leave it empty to switch them off (events
# are still recorded, so adding recipients later delivers the backlog). Set it
# locally too if you want to exercise the mocked delivery path.
ORGANIZER_ALERT_EMAILS=
