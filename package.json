{
  "name": "sample-system",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "test": "if [ \"$NODE_ENV\" != \"production\" ]; then vitest run; else echo 'Tests cannot be run on production environment'; fi",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:coverage": "vitest run --coverage",
    "test:db-regressions": "RBAC_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres python3 tests/rbac-database-regression.py",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --shard=$PLAYWRIGHT_SHARD/$PLAYWRIGHT_TOTAL_SHARDS",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src tests data-scripts",
    "lint:fix": "eslint src tests data-scripts --fix",
    "format": "prettier . --check .",
    "format:fix": "prettier . --write .",
    "test:clean-users": "npx tsx data-scripts/cleanTestUsers.ts",
    "seed:admins": "npx tsx data-scripts/makeAdminUser.ts",
    "seed:organizers": "npx tsx data-scripts/makeOrganizersSeeds.ts",
    "seed:demo-organizers": "npx tsx data-scripts/makeDemoOrganizerSeeds.ts",
    "snapshot:argyle-stub": "npx tsx data-scripts/recordArgyleSandboxResponses.ts",
    "snapshot:argyle-sandbox": "npx tsx data-scripts/snapshotArgyleSandboxGigs.ts",
    "export:argyle-accounts": "npx tsx data-scripts/exportArgyleAccounts.ts",
    "tunnel": "lt --port 5173 --subdomain sample",
    "tunnel:2": "lt --port 5173 --subdomain sample2",
    "tunnel:3": "lt --port 5173 --subdomain sample3"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.55.1",
    "@sveltejs/adapter-netlify": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/svelte": "^5.2.7",
    "@types/file-saver": "^2.0.7",
    "@types/micromodal": "^0.3.5",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^7.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "^10.4.21",
    "daisyui": "^3.9.4",
    "esbuild": "^0.19.12",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.15.0",
    "jsdom": "^21.1.2",
    "localtunnel": "^2.0.2",
    "msw": "^2.11.3",
    "postcss": "^8.5.6",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "supabase": "^1.226.4",
    "svelte": "^5.27.0",
    "svelte-check": "^4.1.6",
    "svelte-eslint-parser": "^1.1.2",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.2.6",
    "vitest": "^2.1.9"
  },
  "type": "module",
  "dependencies": {
    "@json2csv/node": "^7.0.6",
    "@json2csv/plainjs": "^7.0.6",
    "@netlify/functions": "^2.8.2",
    "@sentry/sveltekit": "^8.55.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.4",
    "@sveltejs/kit": "^2.20.7",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/typography": "^0.5.16",
    "@types/lodash": "^4.17.20",
    "FileSaver": "^0.10.0",
    "dotenv": "^17.2.2",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "micromodal": "^0.4.10",
    "moment": "^2.30.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.9",
    "otplib": "^12.0.1",
    "papaparse": "^5.5.3",
    "print-js": "^1.6.0",
    "qrcode": "^1.5.4",
    "short-uuid": "^4.2.2",
    "svelecte": "^5.3.0",
    "svelte-i18n": "^4.0.1",
    "svelte-tel-input": "^3.6.0",
    "tw-elements": "1.0.0-alpha13",
    "twilio": "^4.23.0",
    "uuid": "^10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "core-js",
      "es5-ext",
      "esbuild",
      "msw",
      "supabase",
      "svelte-preprocess"
    ]
  }
}
